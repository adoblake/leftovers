# Local demo mode stores interest submissions privately in .data/interest.jsonl.
# Set to preview for a public demo with no response storage.
# Set to supabase to collect real interest after database setup.
# Without DATA_MODE, production defaults to preview; development defaults to demo.
# Explicit demo mode is rejected in production.
DATA_MODE=demo
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only: never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
# Use the exact HTTPS origin for a real custom domain.
# Vercel deployment origins are detected from trusted hosting variables.
# Omit this variable on Vercel for a public preview.
APP_ORIGIN=http://localhost:3000

# Free Cloudflare Turnstile. Public site key only may use NEXT_PUBLIC_.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Server-only, required for collecting live interest in production.
TURNSTILE_SECRET_KEY=
# Netlify supplies URL/DEPLOY_PRIME_URL/DEPLOY_URL automatically.
# Use APP_ORIGIN for the exact production site URL when opening live intake.
